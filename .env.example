# Copy to .env for local development. Never commit .env.
# Every value here is read by src/app/core/config.py (12-factor: config in env).

APP_NAME=fastapi-boilerplate
ENVIRONMENT=development            # development | test | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console | json  (production must use json)

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-64-byte-random-string-before-running-anywhere-real

# Backing services. Two ways to run locally without Docker:
#   a) real services installed locally (brew install postgresql@16 redis):
#        DATABASE_URL=postgresql+asyncpg://<you>@localhost:5432/fastapi_boilerplate_dev
#        REDIS_URL=redis://localhost:6379/0
#   b) zero-service dev mode (SQLite file + in-process Redis; refused in production):
#        DATABASE_URL=sqlite+aiosqlite:///./dev.db
#        REDIS_URL=memory://
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0

API_PREFIX=/api/v1
DOCS_ENABLED=true                  # forced off in production unless explicitly set

# Comma separated. Empty = no cross-origin browsers allowed (safe default).
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
JWT_ISSUER=fastapi-boilerplate
JWT_AUDIENCE=fastapi-boilerplate-clients

COOKIE_SECURE=false                # true in anything served over HTTPS (forced in production)
COOKIE_SAMESITE=lax
CSRF_ENABLED=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

MAX_REQUEST_BODY_BYTES=1048576

# Optional plugins ("module:ClassName", comma separated). See docs/plugins.md
PLUGINS=
# SENTRY_DSN=
