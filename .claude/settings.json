{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PY=\"$CLAUDE_PROJECT_DIR/.venv/bin/python\"; [ -x \"$PY\" ] || PY=python3; PYTHONPATH=\"$CLAUDE_PROJECT_DIR/tools\" \"$PY\" -m depguard.hook",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
